# Скопируйте в .env.local и подставьте свои значения.
# Строка подключения к PostgreSQL. Для локальной разработки: `bun run db:start`, адрес — из `bunx prisma dev ls` (TCP).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Теневая база для `prisma migrate dev` (у prisma dev она поднимается рядом, на следующем порту).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Размер пула соединений. Для локальной базы prisma dev — строго 1 (она держит одно соединение); для обычного PostgreSQL — 10 и больше
DATABASE_POOL_SIZE="1"

# Better Auth. Секрет: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""
# Адрес приложения — используется в ссылках из писем
BETTER_AUTH_URL="http://localhost:3000"

# Почта (SMTP). Без SMTP_HOST письма печатаются в консоль dev-сервера.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="InternHub <no-reply@example.com>"

# Пароль тестовых пользователей из prisma/seed.ts (только для разработки)
SEED_PASSWORD="internhub-dev"
