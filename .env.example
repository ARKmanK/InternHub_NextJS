# Скопируйте в .env.local и подставьте свои значения.
# Строка подключения к PostgreSQL. Для локальной разработки: `bun run db:start`, адрес — из `bunx prisma dev ls` (TCP).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Теневая база для `prisma migrate dev` (у prisma dev она поднимается рядом, на следующем порту).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Размер пула соединений. Для локальной базы prisma dev — строго 1 (она держит одно соединение); для обычного PostgreSQL — 10 и больше
DATABASE_POOL_SIZE="1"

# Better Auth. Секрет: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""
# Адрес приложения — используется в ссылках из писем
BETTER_AUTH_URL="http://localhost:3000"

# Почта (SMTP). Без SMTP_HOST письма печатаются в консоль dev-сервера.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="InternHub <no-reply@example.com>"

# Пароль тестовых пользователей из prisma/seed.ts (только для разработки)
SEED_PASSWORD="internhub-dev"

# Хранилище файлов (архивы заданий, решения): local — папка на диске, s3 — S3-совместимое хранилище
STORAGE_DRIVER="local"
# Для local: папка (по умолчанию .storage в корне проекта)
# STORAGE_DIR=".storage"
# Для s3 (Timeweb Cloud S3 — см. docs/05-deployment.md). Бакет приватный
# S3_ENDPOINT="https://s3.twcstorage.ru"
# S3_REGION="ru-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Секрет для вызова /api/cron/weekly-reports планировщиком (cron). Сгенерируйте случайную строку
CRON_SECRET=""

# Realtime-сервер (чаты и мгновенные уведомления): `bun run realtime`. Без этих переменных
# приложение работает как раньше: колокольчик опрашивает сервер, сообщения видны после обновления.
# Общий секрет приложения и realtime-сервера (случайная строка, как BETTER_AUTH_SECRET)
REALTIME_SECRET=""
# Порт realtime-сервера
REALTIME_PORT="3001"
# Адрес, по которому приложение публикует события (изнутри сервера/сети docker)
REALTIME_INTERNAL_URL="http://localhost:3001"
# Адрес WebSocket для браузера (в продакшене — wss://ваш-домен/ws через прокси)
REALTIME_PUBLIC_URL="ws://localhost:3001/ws"
