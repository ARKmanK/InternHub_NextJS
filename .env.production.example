# Production-настройки для docker compose. Скопируйте в .env на сервере: cp .env.production.example .env
# Секреты генерируются так: openssl rand -base64 32

# Домен (DNS A-запись → IP сервера). Caddy получит для него сертификат
DOMAIN="internhub.example.ru"

# База (контейнер postgres из docker-compose.yml)
POSTGRES_PASSWORD=""
# Тот же пароль, что выше; хост — имя сервиса postgres
DATABASE_URL="postgres://internhub:ПАРОЛЬ@postgres:5432/internhub"
DATABASE_POOL_SIZE="10"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://internhub.example.ru"

# Почта (SMTP). Например, почта Timeweb: smtp.timeweb.ru, порт 465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="InternHub <no-reply@internhub.example.ru>"

# Файлы — Timeweb Cloud S3 (приватный бакет)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Realtime (чаты и мгновенные уведомления)
REALTIME_SECRET=""
REALTIME_PORT="3001"
REALTIME_INTERNAL_URL="http://realtime:3001"
REALTIME_PUBLIC_URL="wss://internhub.example.ru/ws"

# Еженедельный отчёт работодателям (cron на сервере вызывает /api/cron/weekly-reports)
CRON_SECRET=""
