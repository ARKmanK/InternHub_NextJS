{
	"name": "internhub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fsd": "steiger ./src",
		"typecheck": "prisma generate && next typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "bun run typecheck && bun run lint && bun run lint:fsd && bun run format:check",
		"db:start": "node scripts/db-start.mjs",
		"db:stop": "prisma dev stop internhub",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:reset": "prisma migrate reset",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate",
		"reports:weekly": "node scripts/send-weekly-reports.mjs"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"better-auth": "1.7.14",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.5",
		"date-fns": "^4.4.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.7.0",
		"next": "16.2.2",
		"next-intl": "^4.14.3",
		"next-themes": "^0.4.6",
		"nodemailer": "10.2.1",
		"pg": "8.23.1",
		"radix-ui": "^1.4.3",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.72.1",
		"server-only": "0.0.1",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/nodemailer": "8.0.2",
		"@types/pg": "8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.2.2",
		"prettier": "^3.9.10",
		"prisma": "7.10.1",
		"shadcn": "^4.23.0",
		"steiger": "^0.8.0",
		"tailwindcss": "^4",
		"tsx": "4.23.15",
		"typescript": "~5.9.3"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"@prisma/engines",
		"esbuild",
		"prisma",
		"sharp",
		"unrs-resolver"
	]
}
