// Схема базы данных InternHub.
// Документация по модели данных и жизненным циклам: docs/02-data-model.md
//
// Соглашения:
// - модели и поля в Prisma — PascalCase / camelCase, таблицы и колонки в Postgres — snake_case (@@map / @map);
// - пользователь и всё, что относится к авторизации, использует строковые id (так требует Better Auth, этап 2);
//   остальные сущности — числовые автоинкрементные id;
// - статусы — enum'ы Postgres: в базу нельзя записать несуществующий статус;
// - история смены статусов хранится отдельно (TaskStatusChange, SubmissionStatusChange), а не только текущее значение.

generator client {
  provider = "prisma-client"
  output   = "../src/shared/api/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Пользователи и роли ────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  EMPLOYER
  /// Преподаватель / куратор практики. Назначает администратор
  TEACHER
  ADMIN

  @@map("user_role")
}

enum Locale {
  ru
  en

  @@map("locale")
}

/// Учётная запись. Поля name, email, emailVerified, image, createdAt, updatedAt нужны Better Auth (этап 2).
/// Роль назначает сервер при регистрации; пользователь сам её поменять не может.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          UserRole @default(STUDENT)
  /// Язык интерфейса: на нём приходят письма и показываются уведомления
  locale        Locale   @default(ru)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  studentProfile  StudentProfile?
  employerProfile EmployerProfile?

  createdTasks      Task[]                   @relation("TaskAuthor")
  favorites         Favorite[]
  applications      Application[]
  submissions       Submission[]
  notifications     Notification[]
  taskStatusChanges TaskStatusChange[]
  submissionChanges SubmissionStatusChange[]
  verifiedOrgs      Organization[]           @relation("OrganizationVerifier")
  practicesTaught   Practice[]               @relation("PracticeTeacher")
  practices         PracticeStudent[]

  @@map("users")
}

/// Данные студента: группа и курс связывают профиль с учебным процессом.
model StudentProfile {
  userId    String @id @map("user_id")
  firstName String @map("first_name")
  lastName  String @map("last_name")
  group     String
  course    Int

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Компетенции, которые студент хочет развивать — сигнал для рекомендаций.
  interests Competency[] @relation("StudentInterests")

  @@map("student_profiles")
}

enum OrganizationStatus {
  PENDING // зарегистрирована, ждёт проверки администратором
  VERIFIED // проверена — сотрудники могут публиковать задания
  REJECTED // проверку не прошла
  BLOCKED // заблокирована после жалоб/нарушений

  @@map("organization_status")
}

/// Организация-работодатель. Публиковать задания можно только от имени VERIFIED-организации.
model Organization {
  id           Int                @id @default(autoincrement())
  name         String
  inn          String             @unique
  ogrn         String?            @unique
  website      String?
  status       OrganizationStatus @default(PENDING)
  verifiedAt   DateTime?          @map("verified_at")
  verifiedById String?            @map("verified_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  verifiedBy User?             @relation("OrganizationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  employers  EmployerProfile[]
  tasks      Task[]

  @@index([status])
  @@map("organizations")
}

/// Представитель организации.
model EmployerProfile {
  userId           String    @id @map("user_id")
  organizationId   Int       @map("organization_id")
  position         String?
  /// Когда отправлен последний еженедельный отчёт: следующий охватывает решения после этой даты,
  /// а повторный запуск задачи по расписанию не пришлёт письмо дважды
  lastReportSentAt DateTime? @map("last_report_sent_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("employer_profiles")
}

// ─── Задания ────────────────────────────────────────────────────────────────

enum TaskStatus {
  DRAFT // черновик, видит только автор
  MODERATION // отправлено администратору на проверку
  PUBLISHED // опубликовано, студенты могут подавать заявки и решения
  CLOSED // набор/приём решений завершён
  ARCHIVED // в архиве

  @@map("task_status")
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD

  @@map("task_difficulty")
}

/// Условия использования результата — вопрос интеллектуальной собственности решается при создании задания.
enum IpTerms {
  OPEN // решение можно публиковать (GitHub, портфолио)
  PORTFOLIO_ONLY // можно показать в портфолио на платформе, но не публиковать код
  NDA // результат закрытый, сдаётся архивом, в портфолио — только факт выполнения

  @@map("ip_terms")
}

model Task {
  id                Int            @id @default(autoincrement())
  title             String         @db.VarChar(50)
  description       String         @db.VarChar(3000)
  expectedResult    String?        @map("expected_result") @db.VarChar(2000)
  /// Критерии, по которым работодатель оценивает решения.
  criteria          String?        @db.VarChar(2000)
  difficulty        TaskDifficulty
  status            TaskStatus     @default(DRAFT)
  ipTerms           IpTerms        @default(OPEN) @map("ip_terms")
  /// Обязательна ли ссылка на репозиторий при сдаче (для NDA обычно нет).
  requireRepository Boolean        @default(true) @map("require_repository")
  /// null — без ограничения по числу исполнителей.
  maxParticipants   Int?           @map("max_participants")
  deadline          DateTime?
  /// Ключ архива с материалами в файловом хранилище (не публичная ссылка).
  archiveKey        String?        @map("archive_key")
  organizationId    Int            @map("organization_id")
  authorId          String         @map("author_id")
  publishedAt       DateTime?      @map("published_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author        User               @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  tags          Tag[]
  competencies  Competency[]       @relation("TaskCompetencies")
  favorites     Favorite[]
  applications  Application[]
  submissions   Submission[]
  statusChanges TaskStatusChange[]
  practices     PracticeTask[]

  // Лента: опубликованные задания, новые сверху
  @@index([status, publishedAt(sort: Desc)])
  @@index([organizationId])
  @@index([authorId])
  @@map("tasks")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(20)
  tasks Task[]

  @@map("tags")
}

/// Справочник компетенций. В отличие от тегов (технологии, свободный ввод) —
/// фиксированный список, который ведёт платформа: по нему строится профиль студента.
model Competency {
  id     Int    @id @default(autoincrement())
  /// Стабильный ключ для кода и сида, не меняется при переименовании
  code   String @unique @db.VarChar(40)
  nameRu String @map("name_ru") @db.VarChar(60)
  nameEn String @map("name_en") @db.VarChar(60)

  tasks              Task[]           @relation("TaskCompetencies")
  interestedStudents StudentProfile[] @relation("StudentInterests")

  @@map("competencies")
}

/// История статусов задания: кто, когда и с каким комментарием перевёл (в т.ч. решения модератора).
model TaskStatusChange {
  id          Int         @id @default(autoincrement())
  taskId      Int         @map("task_id")
  fromStatus  TaskStatus? @map("from_status")
  toStatus    TaskStatus  @map("to_status")
  comment     String?     @db.VarChar(2000)
  changedById String      @map("changed_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_status_changes")
}

/// Избранное студента. Число отслеживаний задания = количество записей здесь (без отдельного счётчика).
model Favorite {
  studentId String   @map("student_id")
  taskId    Int      @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([studentId, taskId])
  @@index([taskId])
  @@map("favorites")
}

// ─── Участие и решения ──────────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("application_status")
}

/// Заявка студента на выполнение задания. Решение можно сдать только по принятой заявке.
model Application {
  id        Int               @id @default(autoincrement())
  taskId    Int               @map("task_id")
  studentId String            @map("student_id")
  status    ApplicationStatus @default(PENDING)
  message   String?           @db.VarChar(1000)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
  @@map("applications")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED

  @@map("submission_status")
}

/// Решение студента. Один студент — одно решение на задание; доработки меняют его статус, история — в SubmissionStatusChange.
model Submission {
  id            Int              @id @default(autoincrement())
  taskId        Int              @map("task_id")
  studentId     String           @map("student_id")
  status        SubmissionStatus @default(DRAFT)
  repositoryUrl String?          @map("repository_url")
  comment       String?          @db.VarChar(2000)
  /// Оценка работодателя по шкале 1–5 (выставляется при ACCEPTED).
  score         Int?
  reviewComment String?          @map("review_comment") @db.VarChar(2000)
  submittedAt   DateTime?        @map("submitted_at")
  reviewedAt    DateTime?        @map("reviewed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  task          Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student       User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files         SubmissionFile[]
  statusChanges SubmissionStatusChange[]

  @@unique([taskId, studentId])
  @@index([studentId, status])
  @@map("submissions")
}

enum SubmissionFileKind {
  ARCHIVE
  IMAGE

  @@map("submission_file_kind")
}

/// Файл решения. В базе — только метаданные и ключ в хранилище; сам файл — в объектном хранилище (этап 3).
model SubmissionFile {
  id           Int                @id @default(autoincrement())
  submissionId Int                @map("submission_id")
  kind         SubmissionFileKind
  storageKey   String             @unique @map("storage_key")
  fileName     String             @map("file_name")
  mimeType     String             @map("mime_type")
  sizeBytes    Int                @map("size_bytes")
  createdAt    DateTime           @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

model SubmissionStatusChange {
  id           Int               @id @default(autoincrement())
  submissionId Int               @map("submission_id")
  fromStatus   SubmissionStatus? @map("from_status")
  toStatus     SubmissionStatus  @map("to_status")
  comment      String?           @db.VarChar(2000)
  changedById  String            @map("changed_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  changedBy  User       @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@map("submission_status_changes")
}

// ─── Уведомления ────────────────────────────────────────────────────────────

/// Вид события. Текст уведомления в базе не хранится: его собирают из типа и параметров
/// при показе — на языке того, кто читает (entities/notification/ui/translations.ts).
enum NotificationType {
  TASK_ON_MODERATION
  TASK_EDITED
  TASK_PUBLISHED
  TASK_RETURNED
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_DECLINED
  SOLUTION_RECEIVED
  SOLUTION_RESUBMITTED
  SOLUTION_ACCEPTED
  SOLUTION_CHANGES_REQUESTED
  SOLUTION_REJECTED
  ORGANIZATION_VERIFIED
  ORGANIZATION_REJECTED
  PRACTICE_ADDED
  PRACTICE_GRADED

  @@map("notification_type")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @map("user_id")
  type      NotificationType
  /// Подстановки для текста: { taskTitle, studentName, comment }
  params    Json             @default("{}")
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Непрочитанные уведомления пользователя
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Таблицы Better Auth (этап 2) ───────────────────────────────────────────
// Структура совпадает со схемой Better Auth; на этапе 2 сверим её командой `@better-auth/cli generate`.

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Хэш пароля (bcrypt/scrypt) — открытый пароль нигде не хранится.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Практики (роль преподавателя) ─────────────────────────────────────────

/// Учебная практика или дисциплина: преподаватель собирает группу студентов и набор заданий,
/// следит за прогрессом и выставляет итоговую оценку.
model Practice {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(2000)
  teacherId   String   @map("teacher_id")
  startsAt    DateTime @map("starts_at") @db.Date
  endsAt      DateTime @map("ends_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher  User              @relation("PracticeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  students PracticeStudent[]
  tasks    PracticeTask[]

  @@index([teacherId])
  @@map("practices")
}

/// Итоговая оценка по практике — пятибалльная шкала вуза.
enum PracticeGrade {
  EXCELLENT // отлично
  GOOD // хорошо
  SATISFACTORY // удовлетворительно
  UNSATISFACTORY // неудовлетворительно

  @@map("practice_grade")
}

model PracticeStudent {
  practiceId   Int            @map("practice_id")
  studentId    String         @map("student_id")
  grade        PracticeGrade?
  gradeComment String?        @map("grade_comment") @db.VarChar(2000)
  gradedAt     DateTime?      @map("graded_at")
  addedAt      DateTime       @default(now()) @map("added_at")

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([practiceId, studentId])
  @@index([studentId])
  @@map("practice_students")
}

model PracticeTask {
  practiceId Int      @map("practice_id")
  taskId     Int      @map("task_id")
  addedAt    DateTime @default(now()) @map("added_at")

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([practiceId, taskId])
  @@index([taskId])
  @@map("practice_tasks")
}
